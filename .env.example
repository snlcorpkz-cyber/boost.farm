# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project.supabase.co:5432/postgres

# Auth
JWT_SECRET=your-jwt-secret-change-this

# Telegram Mini App (BotFather → token). Required for POST /auth/telegram
TELEGRAM_BOT_TOKEN=

# Server
CLIENT_URL=http://localhost:5173
PUBLIC_URL=https://boostfarm.io
PORT=3001

# Reporting timezone for the admin analytics surface (retention
# cohorts, AppsFlyer cost ingestion, segment rollups). Must be an
# IANA TZ identifier. Pick the one your AppsFlyer + Facebook Ads
# Manager accounts are configured for so admin metrics line up
# with what those dashboards display. Default Asia/Almaty.
REPORTING_TIMEZONE=Asia/Almaty

# ─────────────────────────────────────────────────────────────
# Meta App Events / Conversions API (CAPI)
# ─────────────────────────────────────────────────────────────
# These credentials are OPTIONAL. When any of them is missing the
# CAPI worker short-circuits and the app behaves exactly as before
# (no Meta events). This lets the rest of the stack boot cleanly
# in dev / CI without needing a Business Manager account.
#
# META_APP_ID          — numeric app id from Meta Business Manager
#                        (same value that goes into the Android
#                        `facebook_app_id` string resource).
# META_APP_SECRET      — app secret from Settings → Basic. Used to
#                        sign the `appsecret_proof` on every CAPI
#                        request, which Meta requires when you use
#                        a long-lived system-user token.
# META_CAPI_ACCESS_TOKEN
#                      — long-lived system-user access token with
#                        the `ads_management` (or App Events) scope
#                        on the app. Generated in Business Manager
#                        → System Users → Assign Assets.
# META_TEST_EVENT_CODE — optional test-mode code from Events Manager.
#                        When set, Meta accepts events but routes
#                        them to the "Test Events" panel only. Use
#                        during staging; leave blank in prod.
# META_CAPI_ENABLED    — feature flag. Set to "true" in prod once
#                        the Business Manager setup is verified.
#                        Defaults to false so the worker runs but
#                        stays dormant until explicitly turned on.
META_APP_ID=
META_APP_SECRET=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=false

# ─────────────────────────────────────────────────────────────
# AppsFlyer Server-to-Server (S2S) — optional event redundancy
# ─────────────────────────────────────────────────────────────
# Lets the API worker mirror critical events (registration,
# tutorial finish, EngagedD0, purchases) directly to AppsFlyer
# server-side so attribution survives even if the client SDK
# fails to dispatch (battery saver, force-quit, network loss).
#
# Leave APPSFLYER_S2S_ENABLED=false in dev — the client SDK
# already covers 99% of events on its own. Flip to true in prod
# only when the client integration is healthy and you want the
# extra survival guarantee.
#
# APPSFLYER_S2S_DEV_KEY    — same dev key used by the Android SDK
#                            (AppsFlyer dashboard → App Settings).
# APPSFLYER_APP_ID         — Android package name prefixed with "id":
#                            `id` + applicationId, e.g.
#                            `idcom.boostfarm.app`.
# APPSFLYER_S2S_EVENT_NAMES
#                          — comma-separated allow-list of internal
#                            event names that the worker is allowed
#                            to send. Empty/unset = nothing fires.
#
#                            Available mappings (see appsflyer/s2s.ts):
#                              auth.register                  → af_complete_registration
#                              onboarding.tutorial_finished   → af_tutorial_completion
#                              EngagedD0                      → af_engaged_d0
#                              farm.stage_reached             → af_stage_<N>_reached
#                                                              (N = 2..6 from properties.stage)
#                              farm.harvested                 → af_harvest_completed
#                              farm.harvest_x3                → af_harvest_x3
#                              retention.d1_return            → af_d1_return
#                              retention.d3_return            → af_d3_return
#                              retention.d7_return            → af_d7_return
#                              econ.offer_completed           → af_offer_completed
#                              econ.purchase                  → af_purchase
#
#                            Recommended starter list (events the SDK
#                            CANNOT fire reliably from the client side):
#                              retention.d1_return,retention.d3_return,retention.d7_return,econ.offer_completed
#
#                            DO NOT add events the web SDK already fires
#                            (auth.register, onboarding.tutorial_finished,
#                            EngagedD0, farm.stage_reached, farm.harvested)
#                            unless you specifically need server-side
#                            redundancy for non-Android users (Telegram /
#                            web-only). AF dedupes by 30-min window but
#                            client/server clock drift can produce duplicates.
APPSFLYER_S2S_ENABLED=false
APPSFLYER_S2S_DEV_KEY=
APPSFLYER_APP_ID=
APPSFLYER_S2S_EVENT_NAMES=

# ─────────────────────────────────────────────────────────────
# AppsFlyer Cost Pull — Aggregated Reports API
# ─────────────────────────────────────────────────────────────
# Daily worker that pulls partners_by_date_report v5 from
# AppsFlyer and stores per-day spend / impressions / clicks /
# installs in the `ad_costs` table. Powers the CPI + ROAS
# columns on the admin Retention page.
#
# Independent of APPSFLYER_S2S_* — different token (this is a V2
# JWT for the Pull API, not the SDK dev key) and different
# rate-limit budget (24 calls/day on the aggregated endpoint).
#
# Token retrieval:
#   1. AF dashboard → click your email avatar (top right)
#   2. Security center → Manage AppsFlyer API tokens
#   3. Copy the V2 token (admins only). It's a long JWT string.
#   4. Paste below as APPSFLYER_PULL_API_TOKEN.
#
# When 401/403/404 lands, the worker logs once and disables itself
# until the next process restart — the rest of the API keeps
# working, retention page just shows "—" in the cost columns.
#
# AF_COST_PULL_ENABLED   — feature flag. Default false so dev/CI
#                          boots without this token. Flip to true
#                          in prod once the token is set.
# APPSFLYER_PULL_API_TOKEN
#                        — V2 JWT bearer token from AF Security
#                          center. NOT the SDK dev key.
# APPSFLYER_APP_ID       — reused from the S2S block above. The
#                          aggregated report is per-app so the id
#                          must match the app whose token this is.
AF_COST_PULL_ENABLED=false
APPSFLYER_PULL_API_TOKEN=
